{
  "name": "@bridgenode/llm",
  "version": "1.0.6",
  "description": "BridgeNode LLM client — AI inference for AI agents with x402 payment on Solana USDC. No API keys, no registration.",
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "skills",
    "server.json",
    "AGENTS.md",
    "glama.json"
  ],
  "scripts": {
    "build": "tsup",
    "test": "node --test --test-isolation=none --test-concurrency=1 --import tsx tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "license": "MIT-0",
  "homepage": "https://bridgenode.cc",
  "repository": {
    "type": "git",
    "url": "https://github.com/bridgenode-ai/bridgenode-sdk-ts.git"
  },
  "keywords": [
    "x402",
    "http-402",
    "agentic-commerce",
    "pay-per-request",
    "solana",
    "usdc",
    "micropayments",
    "llm",
    "ai-agents",
    "bridgenode",
    "openai-compatible"
  ],
  "dependencies": {
    "@solana/kit": "^7.1.0",
    "@x402/core": "~2.23.0",
    "@x402/extensions": "^2.23.0",
    "@x402/svm": "~2.24.0",
    "dotenv": "^17.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsup": "^8.5.1",
    "tsx": "^4.20.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20"
  },
  "author": "BridgeNode <eli.BNx@proton.me>",
  "bugs": {
    "url": "https://github.com/bridgenode-ai/bridgenode-sdk-ts/issues"
  },
  "funding": {
    "type": "individual",
    "url": "https://bridgenode.cc"
  },
  "agents": {
    "skills": [
      {
        "name": "bridgenode",
        "path": "./skills/bridgenode"
      }
    ]
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
